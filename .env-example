# Flask
FLASK_SECRET_KEY=change-me-in-local-development

# GitHub access
GITHUB_TOKEN=ghp_replace_with_your_token

# GitHub webhook validation
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret

# PR Guardian paths
PR_GUARDIAN_WORKSPACE=workspace/repositories
PR_GUARDIAN_REPORTS=reports
PR_GUARDIAN_HOST=127.0.0.1
PR_GUARDIAN_PORT=5000
PR_GUARDIAN_DEBUG=true

# Verification
PR_GUARDIAN_RUN_VERIFICATION=true

# Flask runtime
FLASK_APP=run.py
FLASK_ENV=development